OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.1

# --- Configuração para deploy na nuvem (ex: Streamlit Community Cloud) ---
# Sem Ollama disponível publicamente, use HuggingFace (gratuito, sem chave)
# para embeddings e um provedor compatível com a API da OpenAI para o chat.
#
# EMBEDDING_PROVIDER=huggingface
# HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
#
# Alternativa recomendada para o Streamlit Cloud (evita dependência de torch):
# EMBEDDING_PROVIDER=gemini
# GOOGLE_EMBEDDING_MODEL=models/text-embedding-004
#
# LLM_PROVIDER=openai
# OPENAI_API_KEY=coloque_sua_chave_aqui
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=   # opcional, para endpoints compatíveis (ex: Groq)
#
# LLM_PROVIDER=gemini
# GOOGLE_API_KEY=coloque_sua_chave_aqui
# GOOGLE_MODEL=gemini-1.5-flash
# GOOGLE_VISION_MODEL=gemini-1.5-flash
# GOOGLE_AUDIO_MODEL=gemini-1.5-flash
# GOOGLE_VIDEO_MODEL=gemini-1.5-flash

# --- Supabase (persistência de mensagens e fontes) ---
# SUPABASE_URL=https://xyzabcdef.supabase.co
# SUPABASE_KEY=eyJ...
